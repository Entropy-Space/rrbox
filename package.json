{
  "name": "researchbox-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @researchbox/web dev",
    "dev:native": "pnpm --filter @researchbox/native tauri dev",
    "dev:native:ios": "pnpm --filter @researchbox/native dev:ios",
    "build": "pnpm run build:web && pnpm run build:dshrbox && pnpm run build:native",
    "build:dshrbox": "pnpm --filter @dshrbox/runtime-browser build",
    "build:python-wasm": "wasm-pack build packages/python-plugin --target web --out-dir pkg --release",
    "build:web": "pnpm run build:python-wasm && pnpm --filter @researchbox/web build",
    "build:native": "pnpm --filter @researchbox/native build",
    "build:native:ios-sim": "pnpm --filter @researchbox/native build:ios-sim",
    "check:native": "cargo check --manifest-path apps/native/src-tauri/Cargo.toml",
    "start": "pnpm --filter @researchbox/web start",
    "test": "pnpm run typecheck && pnpm run build && pnpm run check:native && pnpm run test:python-rust && pnpm run test:native-rust && node --experimental-strip-types --test apps/*/test/*.test.mjs packages/*/test/*.test.mjs",
    "test:python-rust": "cargo test --release --manifest-path packages/python-plugin/Cargo.toml -- --test-threads=1",
    "test:native-rust": "cargo test --manifest-path apps/native/src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint apps packages --ignore-pattern dist --ignore-pattern .next"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "next": "16.2.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
